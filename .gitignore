# Visfor360 .gitignore (Laravel 13 skeleton + proje özel)

# --- Gizli / müşteri verisi (public repoya girmez) ---
/references/
/secrets/
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# --- Bağımlılıklar ---
/vendor/
/node_modules/

# --- Laravel runtime ---
/storage/pail
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/storage/app/private/*
/storage/app/public/*
/bootstrap/cache/*
/bootstrap/ssr
/database/database.sqlite
/public/fonts-manifest.dev.json
!**/.gitignore

# --- Derleme çıktıları ---
/public/build
/public/hot
/public/storage

# --- Test / ölçüm ---
/.phpunit.cache
/.phpunit.result.cache
.phpunit.result.cache
/coverage*
/playwright-report/
/test-results/
/.playwright/

# --- IDE / OS ---
/.idea
/.vscode
/.zed
/.fleet
/.nova
/.cursor
/.claude
/.codex
/.agents
/.grok
/.junie
/.kiro
/.factory
/.pi
/.amp
/.mcp.json
/boost.json
/opencode.json
/opencode.jsonc
/.phpactor.json
.phpactor.json
.DS_Store
Thumbs.db
*.swp
npm-debug.log
yarn-error.log
*.log

# --- Yerel yardımcılar (repo dışı) ---
/tools/
